#!/bin/sh

set -eu

clodex_wrapper='@CLODEX_CLAUDE_BIN@'
default_system_prompt_file="$HOME/.config/claudex-clodex/system-prompt.md"
system_prompt_file=${CLAUDEX_SYSTEM_PROMPT_FILE:-$default_system_prompt_file}

if [ "$#" -eq 0 ]; then
	printf '%s\n' 'claudex-process-wrapper: missing Claude Code executable' >&2
	exit 2
fi
if [ ! -x "$clodex_wrapper" ]; then
	printf 'claudex-process-wrapper: Clodex wrapper is missing: %s\n' \
		"$clodex_wrapper" >&2
	exit 1
fi
if [ ! -r "$system_prompt_file" ]; then
	printf 'claudex-process-wrapper: system prompt file is not readable: %s\n' \
		"$system_prompt_file" >&2
	exit 1
fi
claude_path=$1
shift

has_parent_prompt=0
has_subagent_prompt=0
print_mode=0
for arg; do
	case "$arg" in
	--)
		break
		;;
	--append-system-prompt | --append-system-prompt=* | \
		--append-system-prompt-file | --append-system-prompt-file=*)
		has_parent_prompt=1
		;;
	--append-subagent-system-prompt | --append-subagent-system-prompt=* | \
		--append-subagent-system-prompt-file | --append-subagent-system-prompt-file=*)
		has_subagent_prompt=1
		;;
	-p | --print | --print=*)
		print_mode=1
		;;
	esac
done

# Keep the cc-enhanced wrapper on this same composed file if it is the client.
export CC_ENHANCED_PROMPT_FILE="$system_prompt_file"
unset CC_ENHANCED_SUBAGENT_PROMPT_FILE
if [ "$has_parent_prompt" -eq 0 ]; then
	set -- --append-system-prompt-file "$system_prompt_file" "$@"
fi
if [ "$has_subagent_prompt" -eq 0 ]; then
	if [ "$print_mode" -eq 1 ]; then
		set -- --append-subagent-system-prompt-file "$system_prompt_file" "$@"
		export CLAUDE_CODE_ENABLE_APPEND_SUBAGENT_PROMPT="${CLAUDE_CODE_ENABLE_APPEND_SUBAGENT_PROMPT:-1}"
	else
		# Stock ignores the flag in interactive sessions; cc-enhanced's plugin
		# delivers this file as SubagentStart additional context instead.
		export CC_ENHANCED_SUBAGENT_PROMPT_FILE="$system_prompt_file"
	fi
fi

exec "$clodex_wrapper" "$claude_path" "$@"
