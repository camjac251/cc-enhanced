{
  "name": "cc-enhanced",
  "version": "1.0.0",
  "private": true,
  "description": "Claude Code plugin mod, setup script, and release-auditing tools.",
  "scripts": {
    "bounded": "bun --smol scripts/run-memory-limited.ts --",
    "cli": "bun --smol scripts/run-memory-limited.ts -- bun --smol src/index.ts",
    "native:unpack": "bun run cli -- --native-unpack",
    "native:pull": "bun run cli -- --native-pull",
    "native:fetch": "bun run cli -- --native-fetch",
    "inspect": "bun --smol scripts/run-memory-limited.ts -- bun --smol src/inspector.ts",
    "diff": "bun --smol scripts/run-memory-limited.ts -- bun --smol src/diff.ts",
    "verify:mods": "bun --smol scripts/run-memory-limited.ts -- bun --smol scripts/verify-mods.ts",
    "prompts:export": "bun --smol scripts/run-memory-limited.ts -- bun --smol scripts/export-prompts.ts",
    "prompts:bundle": "bun --smol scripts/run-memory-limited.ts -- bun --smol scripts/export-prompts.ts --bundle",
    "harness:map": "bun scripts/harness-map.ts",
    "prompts:compare": "bun --smol scripts/run-memory-limited.ts -- bun --smol scripts/compare-prompts.ts",
    "prompts:compare:matrix": "bun --smol scripts/run-memory-limited.ts -- bun --smol scripts/compare-prompt-matrix.ts",
    "docs:format": "prettier --write README.md \"docs/**/*.md\"",
    "docs:check": "prettier --check README.md \"docs/**/*.md\"",
    "test": "bun --smol scripts/run-memory-limited.ts -- node scripts/run-tests-serial.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ scripts/ tests/ plugin/ mods/",
    "lint:fix": "biome check --write src/ scripts/ tests/ plugin/ mods/",
    "format": "biome format --write src/ scripts/ tests/ plugin/ mods/",
    "changelog": "bun scripts/changelog.ts",
    "verify:minimum": "bun --smol scripts/run-memory-limited.ts -- bun --smol scripts/verify-minimum.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^26.0.0",
    "@types/yargs": "^17.0.35",
    "prettier": "3.9.6",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "chalk": "^6.0.0",
    "diff": "^9.0.0",
    "node-lief": "1.3.2",
    "yargs": "^18.0.0"
  },
  "type": "module"
}
