{
	"name": "patcher",
	"version": "1.0.0",
	"description": "Power-user local CLI patcher with verifiable bundle patches for tool ergonomics, prompt cleanup, workflow controls, runtime guards, and native repacking.",
	"main": "index.js",
	"scripts": {
		"cli": "bun src/index.ts",
		"patch:target": "bun run cli -- --target",
		"native:backup": "bun run cli -- --backup-only --target",
		"native:restore": "bun run cli -- --restore --target",
		"native:unpack": "bun run cli -- --native-unpack",
		"native:unpack-current": "bun run cli -- --detect-target --unpack",
		"native:repack": "bun run cli -- --native-repack",
		"native:pull": "bun run cli -- --native-pull",
		"native:fetch": "bun run cli -- --native-fetch-only",
		"native:fetch-patch": "bun run cli -- --native-fetch-patch",
		"native:update": "bun run cli -- --update",
		"native:promote": "bun run cli -- --promote",
		"native:rollback": "bun run cli -- --rollback",
		"status": "bun run cli -- --status",
		"desktop:status": "bun scripts/desktop-status.ts",
		"desktop:compare": "bun scripts/desktop-compare.ts",
		"desktop:inspect": "bun scripts/desktop-inspect.ts",
		"desktop:sdk-contract": "bun scripts/desktop-sdk-contract.ts",
		"desktop:permission-probe": "bun scripts/desktop-permission-probe.ts",
		"desktop:permission-preflight": "bun scripts/desktop-permission-preflight.ts",
		"desktop:candidate": "bun scripts/desktop-candidate.ts",
		"profile:support": "bun scripts/profile-support.ts",
		"remote:plan": "bun scripts/remote-control.ts",
		"remote:doctor": "bun scripts/remote-control.ts --doctor",
		"remote:start": "bun scripts/remote-control.ts --doctor --start",
		"remote:artifacts": "bun scripts/verify-native-artifact-matrix.ts --profile remote-control",
		"remote:host": "bun scripts/verify-native-host.ts --expected-profile remote-control",
		"self-hosted:plan": "bun scripts/self-hosted.ts",
		"self-hosted:artifacts": "bun scripts/verify-native-artifact-matrix.ts --profile self-hosted-runner --platform linux-x64 --platform linux-arm64 --platform linux-x64-musl --platform linux-arm64-musl --platform darwin-x64 --platform darwin-arm64",
		"self-hosted:host": "bun scripts/verify-native-host.ts --expected-profile self-hosted-runner",
		"self-hosted:image": "bun scripts/self-hosted-image.ts",
		"self-hosted:wrapper": "bun scripts/self-hosted-wrapper.ts",
		"self-hosted:wrapper-image": "bun scripts/self-hosted-wrapper-image.ts",
		"list": "bun run cli -- --list",
		"inspect": "bun src/inspector.ts",
		"diff": "bun src/diff.ts",
		"verify:patches": "bun scripts/verify-patches.ts",
		"verify:patches:matrix": "bun scripts/verify-patches.ts --matrix",
		"verify:native-artifacts": "bun scripts/verify-native-artifact-matrix.ts",
		"verify:native-host": "bun scripts/verify-native-host.ts",
		"patch-evidence:compare": "bun scripts/compare-patch-evidence.ts",
		"verify:anchors": "bun src/index.ts --verify-anchors",
		"verify:prompt-surfaces": "bun src/index.ts --verify-prompt-surfaces",
		"verify:prompt-drift": "bun src/index.ts --verify-prompt-drift",
		"prompt-drift:baseline": "bun src/index.ts --write-prompt-drift-baseline",
		"verify:cache": "bun src/verification/verify-cache-efficiency.ts",
		"verify:cache:agent": "bun src/verification/verify-cache-efficiency.ts --preset agent",
		"workflow:fingerprint": "bun scripts/workflow-replay-fingerprint.ts",
		"prompts:export": "bun scripts/export-prompts.ts",
		"prompts:bundle": "bun scripts/export-prompts.ts --bundle",
		"harness:map": "bun scripts/harness-map.ts",
		"prompts:compare": "bun scripts/compare-prompts.ts",
		"prompts:compare:matrix": "bun scripts/compare-prompt-matrix.ts",
		"prompts:drift-baseline": "bun src/index.ts --write-prompt-drift-baseline",
		"test": "node scripts/run-tests-serial.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/ scripts/",
		"lint:fix": "biome check --write src/ scripts/",
		"format": "biome format --write src/ scripts/"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"packageManager": "bun@1.4.0-canary.1",
	"devDependencies": {
		"@babel/template": "^8.0.0",
		"@biomejs/biome": "^2.4.16",
		"@types/node": "^26.0.0",
		"@types/yargs": "^17.0.35",
		"typescript": "^7.0.0"
	},
	"dependencies": {
		"@babel/generator": "^8.0.0",
		"@babel/parser": "^8.0.4",
		"@babel/traverse": "^8.0.4",
		"@babel/types": "^8.0.4",
		"chalk": "^6.0.0",
		"diff": "^9.0.0",
		"node-lief": "1.3.2",
		"ora": "^9.4.0",
		"yargs": "^18.0.0"
	},
	"type": "module"
}
