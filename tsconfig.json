{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowJs": true,
		"strict": true,
		"esModuleInterop": true,
		"types": ["node"],
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	},
	"include": ["src/**/*", "scripts/**/*", "tests/**/*", "plugin/**/*.ts", "types/**/*.d.ts", "mods/**/*.ts"],
	"exclude": ["node_modules"]
}
